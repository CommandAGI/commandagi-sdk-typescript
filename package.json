{
  "name": "commandagi",
  "version": "0.1.1",
  "description": "The CommandAGI SDK and the commandagi CLI — one typed client over the platform API, for developers and agents alike (API-key scope is the only difference).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CommandAGI/commandagi-sdk-typescript.git"
  },
  "homepage": "https://commandagi.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "commandagi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "commandagi-sdk.schema.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
