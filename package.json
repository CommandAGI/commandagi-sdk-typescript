{
  "name": "@commandagi/sdk",
  "version": "0.1.1",
  "description": "The CommandAGI SDK + cagi CLI — one typed surface over the platform for developers AND agents, differentiated only by API-key scope.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commandagi/commandagi.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://commandagi.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cagi": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@commandagi/core": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
