{
  "name": "commandagi",
  "version": "0.2.0",
  "description": "Node/TypeScript SDK for CommandAGI — launch cloud computers and 3D robot simulations and control them programmatically.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["robotics", "simulation", "agents", "pybullet", "computer-use", "commandagi"],
  "homepage": "https://commandagi.com",
  "engines": { "node": ">=18" },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  }
}
