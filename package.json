{
  "name": "commandagi",
  "version": "0.6.8",
  "description": "The CommandAGI SDK: one typed client over the platform API, for developers and agents alike (API-key scope is the only difference), and the primitives that declare documents in code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CommandAGI/commandagi-sdk-typescript.git"
  },
  "homepage": "https://commandagi.com",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "default": "./dist/design/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/design/jsx-runtime.d.ts",
      "default": "./dist/design/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/design/jsx-runtime.d.ts",
      "default": "./dist/design/jsx-runtime.js"
    },
    "./src/*": "./src/*.ts",
    "./threed/jsx-runtime": {
      "types": "./dist/design/threed-jsx-runtime.d.ts",
      "default": "./dist/design/threed-jsx-runtime.js"
    },
    "./threed/jsx-dev-runtime": {
      "types": "./dist/design/threed-jsx-runtime.d.ts",
      "default": "./dist/design/threed-jsx-runtime.js"
    }
  },
  "files": [
    "dist",
    "commandagi-sdk.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
